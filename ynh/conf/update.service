[Unit]
Description=Plan Move : mise à jour mensuelle des données (open data → carte)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/
Environment="PATH=__PATH_WITH_NODEJS__"
Environment=INSTALL_DIR=__INSTALL_DIR__
Environment=DATA_DIR=__DATA_DIR__
Environment=REPORT_EMAIL=__REPORT_EMAIL__
Environment=HOME=__DATA_DIR__
# Le serveur n'a que 3,8 Go : DuckDB plafonné (au-delà il écrit sur disque) …
Environment=PLANMOVE_DUCKDB_MEMORY=1GB
Environment=PLANMOVE_DUCKDB_THREADS=2
# … et le service entier aussi : ralenti et poussé vers le swap au-delà de 2 Go,
# arrêté net à 2,6 Go — le reste du serveur garde toujours de la mémoire.
MemoryHigh=2G
MemoryMax=2600M
MemorySwapMax=1G
ExecStart=/bin/bash __INSTALL_DIR__/ynh/conf/update.sh
StandardOutput=append:/var/log/__APP__/update.log
StandardError=inherit
TimeoutStartSec=6h
Nice=10

# pas de NoNewPrivileges : l'envoi du compte rendu passe par postdrop, qui est setgid
# (sinon « mail_queue_enter: Permission denied » en boucle et aucun mail)
PrivateTmp=yes
ProtectSystem=full
